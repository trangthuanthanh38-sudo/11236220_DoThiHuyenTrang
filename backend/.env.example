# Sao chép file này thành ".env" rồi chỉnh giá trị cho phù hợp máy bạn.
# .env KHÔNG được commit lên git (chứa secret).

# Khớp với database/auth_schema.sql + docker-compose.yml ở gốc project.
DATABASE_URL=mysql+pymysql://root:devpassword@127.0.0.1:3306/ai_studio_tri_thuc

# Bí mật ký JWT — đổi thành chuỗi ngẫu nhiên dài khi lên production.
JWT_SECRET=change-this-dev-secret-please
JWT_ACCESS_EXPIRE_MINUTES=1440
JWT_REFRESH_EXPIRE_DAYS=30

# true = API trả kèm mã OTP trong response (để test không cần tổng đài SMS thật).
# BẮT BUỘC set false khi lên production.
DEV_MODE=true

# Origin của frontend tĩnh (Live Server / http.server) được phép gọi API (CORS).
CORS_ORIGINS=*

# UC-16 (nhánh tải PDF lên) / BR-14: thư mục lưu file PDF gốc trên đĩa (tương đối tính
# từ thư mục chạy uvicorn, tức backend/) và dung lượng tối đa mỗi tệp (MB).
PDF_UPLOAD_DIR=uploads/pdf
FEEDBACK_UPLOAD_DIR=uploads/feedback
# Kích thước tệp tối đa, dung lượng/người, số tệp/môn, lượt AI/ngày: KHÔNG đặt ở đây — admin sửa ở trang
# Hạn mức (bảng quota_settings, UC-33).

# UC-19 (đính kèm ngữ cảnh ở ô nhập AI Chat): thư mục lưu tệp/ảnh đính kèm trên đĩa
# (tương đối tính từ thư mục chạy uvicorn) và dung lượng tối đa mỗi tệp (MB).
CHAT_ATTACHMENT_UPLOAD_DIR=uploads/chat

# UC-20 (Hỏi đáp tri thức, Bước 2 lộ trình RAG): key Gemini API thật — lấy tại
# https://aistudio.google.com/apikey. Để trống = chatbot rơi về câu trả lời cố định
# (không lỗi), tiện cho ai clone repo chưa có key riêng.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Đọc nội dung tệp PDF/ảnh đính kèm ở AI Chat bằng OCR (Tesseract) — engine cài ở máy,
# KHÔNG cài được qua pip. Windows: winget install tesseract-ocr.tesseract (hoặc tải tại
# https://github.com/tesseract-ocr/tesseract). Đổi TESSERACT_CMD nếu cài ở đường dẫn khác
# hoặc trên macOS/Linux (thường chỉ cần "tesseract" nếu đã có trong PATH).
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# Gói ngôn ngữ (eng.traineddata/vie.traineddata) — xem hướng dẫn tải trong CLAUDE.md, KHÔNG
# đặt trong thư mục cài Tesseract mặc định (Program Files, cần quyền admin để ghi thêm).
TESSDATA_DIR=tessdata

# Bước 3 lộ trình RAG (chunking + embedding, backend/app/services/embeddings.py): model sinh
# vector. Đổi giá trị này rồi chạy `python -m app.services.embeddings` để backfill lại toàn bộ
# chunk theo model mới.
EMBEDDING_MODEL=gemini-embedding-001

# Bước 4 lộ trình RAG (vector search): số chunk liên quan nhất lấy ra mỗi câu hỏi và ngưỡng
# cosine similarity tối thiểu để coi là "đủ liên quan". 0.65 đã hiệu chỉnh bằng đo thật với
# gemini-embedding-001 (câu liên quan ~0.73-0.77, câu không liên quan ~0.52-0.56) — có thể
# cần tinh chỉnh lại nếu đổi EMBEDDING_MODEL khác.
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.65
CHAT_HISTORY_MAX_MESSAGES=20
QUIZ_MODEL=gemini-3.6-flash
QUIZ_FALLBACK_MODEL=gemini-3.1-flash-lite,gemini-3.5-flash,gemini-flash-lite-latest
QUIZ_THINKING_LEVEL=low

# Lịch biểu (UC-26/31): múi giờ tính giờ nhắc, chu kỳ quét nhắc lịch nền (giây, 0 = tắt).
APP_TIMEZONE=Asia/Ho_Chi_Minh
SCHEDULER_INTERVAL_SECONDS=30
# Gửi email nhắc lịch. Để trống SMTP_HOST = không gửi email (kênh Email ghi 'skipped').
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_PASSWORD = App Password 16 ký tự
# (https://myaccount.google.com/apppasswords). KHÔNG commit mật khẩu thật.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_SSL=false
# Nút "Mở Lịch biểu" trong email nhắc lịch trỏ tới trang này
APP_URL=http://localhost:5500/html/ghichu.html

# Đăng nhập / đăng ký bằng Google (UC-01/02 luồng 3a): OAuth Client ID loại "Web application"
# (https://console.cloud.google.com/apis/credentials), Authorized JavaScript origins = http://localhost:5500.
# Chỉ cần Client ID, KHÔNG cần Client Secret. Để trống = nút "Tiếp tục với Google" bị khoá.
# Cấu hình 1 lần cho cả app. Chế độ "Testing" chỉ cho Gmail trong Test users đăng nhập -> OAuth consent screen > Publish app để mọi Gmail dùng được.
GOOGLE_CLIENT_ID=
